rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Imágenes de productos: productos/{sellerId}/{productId}/{filename}
    match /productos/{sellerId}/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Fotos de perfil: usuarios/{userId}/{filename}
    match /usuarios/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
