<mxfile host="app.diagrams.net"><diagram name="Diagrama 3. Modelo de datos en Cloud Firestore" id="d1"><mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="usr" value="«colección»&lt;br/&gt;&lt;b&gt;usuarios/{uid}&lt;/b&gt;&lt;hr/&gt;uid, nombre, correo&lt;br/&gt;tipoUsuario (comprador|vendedor)&lt;br/&gt;fechaRegistro, fotoPerfil&lt;br/&gt;telefono" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#F4F4F5;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="300" height="170" as="geometry"/></mxCell><mxCell id="prd" value="«colección»&lt;br/&gt;&lt;b&gt;productos/{id}&lt;/b&gt;&lt;hr/&gt;nombre, descripcion, precio&lt;br/&gt;categoria, estado, cantidad&lt;br/&gt;imagen, vendedorId&lt;br/&gt;calificacionPromedio&lt;br/&gt;numCalificaciones, fechaPublicacion" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#F4F4F5;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="330" height="250" as="geometry"/></mxCell><mxCell id="cal" value="«subcolección»&lt;br/&gt;&lt;b&gt;calificaciones/{uid}&lt;/b&gt;&lt;hr/&gt;usuarioId, estrellas (1-5)&lt;br/&gt;comentario, fecha&lt;br/&gt;nombreUsuario" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#E0F2FE;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="280" height="150" as="geometry"/></mxCell><mxCell id="car" value="«colección»&lt;br/&gt;&lt;b&gt;carritos/{uid}&lt;/b&gt;&lt;hr/&gt;uid, fechaActualizacion" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#F4F4F5;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="100" as="geometry"/></mxCell><mxCell id="itm" value="«subcolección»&lt;br/&gt;&l