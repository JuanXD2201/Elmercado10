<mxfile host="app.diagrams.net"><diagram name="Diagrama 4. Flujo de compra y gestión de pedidos" id="d1"><mxGraphModel dx="1280" dy="600" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a" value="&lt;b&gt;1. Detalle del producto&lt;/b&gt;&lt;hr/&gt;Elige cantidad" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FDE7D6;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="230" height="110" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;2. Agregar al carrito&lt;/b&gt;&lt;hr/&gt;o Comprar ahora&lt;br/&gt;(valida stock y dueño)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FDE7D6;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="230" height="110" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;3. Carrito&lt;/b&gt;&lt;hr/&gt;Revisa cantidades&lt;br/&gt;Confirmar pedido" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FDE7D6;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="230" height="110" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;4. createOrder&lt;/b&gt;&lt;hr/&gt;Transacción Firestore" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#E4E4E7;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="250" height="110" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;Dentro de la transacción&lt;/b&gt;&lt;hr/&gt;Lee cada producto&lt;br/&gt;Valida stock y vendedor&lt;br/&gt;Toma precio del servidor&lt;br/&gt;Descuenta stock" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#E0F2FE;strokeColor=#1F4E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="340" width="250" height="170" a